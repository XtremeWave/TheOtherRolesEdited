    //职业介绍(RoleIntroduction.cs)
    "RoleIntroduction": {
        "0": "Role Introduction",
        "13": "职业介绍"
    },
    "CrewmateRolesText": {
        "0": "Crewmate Roles",
        "13": "船员职业"
    },
    "ImpostorRolesText": {
        "0": "Impostor Roles",
        "13": "内鬼职业"
    },
    "NeutralRolesText": {
        "0": "Neutral Roles",
