    },
    //注:根据字符数量换行
    "ImpostorFullDesc": {
        "0": "Regular Impostor wins by sabotaging facilities \nand eliminating crewmates.",
        "13": "普通内鬼利用破坏和击杀以获得胜利。"
    },
    "GodfatherFullDesc": {
        "0": "The Godfather, leader of the Mafia.\nPossesses the same abilities as a regular Impostor; \nsecure victory via sabotage and kills.",
        "13": "黑手党老大。\n技能和普通内鬼一样利用破坏和击杀以获得胜利。"
    },
    "MafiosoFullDesc": {
        "0": "A member of the Mafia.\nCannot perform kills while the Godfather is alive \nand may only use sabotage abilities.\nKill ability unlocks upon the Godfather's death;\nwin the game just like a standard Impostor \nthrough sabotage and eliminations.",
        "13": "黑手党之一。\n在教父死之前无法使用击杀技能，\n仅可利用破坏。\n教父死后击杀技能被激活,\n和普通内鬼一样利用破坏和击杀以获得胜利。"
    },
    "JanitorFullDesc": {
        "0": "A member of the Mafia.\nClears corpses for the Godfather and Mafioso, \nwith no kill or sabotage abilities.\nNote: The Janitor never gains the kill button \neven if both the Godfather and Mafioso are eliminated.",
        "13": "黑手党之一。\n帮助教父和小弟清理尸体，且没有击杀和破坏技能。\n注意:当教父和小弟都死亡后清洁工也不会被激活击杀键。"
    },
    "BadGuesserFullDesc": {
        "0": "During meetings, identify others' roles \nfrom their statements and execute them with a guess ability.\nWarning: You will die instantly if your guess is incorrect.",
        "13": "会议上可以通过他人发言确定职业后，\n可通过猜测技能将其赌死。\n注意:如果猜测错误你将会死亡。"
    },
    "MorphlingFullDesc": {
        "0": "Sample a target player to take on their appearance.",
        "13": "采样后可以伪装成其他人。"
    },
    "BomberFullDesc": {
        "0": "Place a bomb on the map.\nOnce activated, the bomb creates a set explosion radius \n(configurable in room settings).\nAnyone within range when the countdown ends gets killed.\nThe bomb can be defused with the defuse button \nbefore the timer expires.",
        "13": "您可以放置一个炸弹。\n炸弹激活后会有一个炸弹范围(根据设置)。\n在此范围内倒计时结束的人会被炸死。\n在倒计时结束前可以利用拆除按钮拆除炸弹。"
    },
    "CamouflagerFullDesc": {
        "0": "Activating the ability turns every player \ninto an anonymous silhouette.",
        "13": "开启技能后所有人进入小黑人状态。"
    },
    "MinerFullDesc": {
        "0": "Dig custom new vent tunnels separate \nfrom the original map vents.\nAll vent-capable roles are able \nto use these player-dug tunnels.",
        "13": "可以挖掘管道。\n挖掘的管道不与地图上的管道相同。\n且所有可以使用管道的职业均可使用矿工挖掘的管道。"
    },
    "EraserFullDesc": {
        "0": "Erase a target's special role and turn them \ninto a vanilla Crewmate. The effect takes effect \nafter the next meeting.",
        "13": "可以抹去目标职业。使其变成白板船员，使用技能后需过一轮会议生效。"
    },
    "VampireFullDesc": {
        "0": "Victims drained of blood die after a short delay.\nWhen the Vampire spawn chance is above 0%, \nevery player starts with a garlic.\nWithin garlic aura range, the Vampire can only \nperform direct instant kills instead of delayed blood drain.",
        "13": "被吸血的玩家在几秒后暴毙。\n\n吸血鬼出现概率不为0%时会为所有玩家发放大蒜，\n开局每人获得一个大蒜，在大蒜范围内，\n吸血鬼只能直接出刀而不能吸血（延迟刀）。"
    },
    "CleanerFullDesc": {
        "0": "Use the clean ability on corpses \nto make them disappear entirely.\nYour kill ability enters cooldown simultaneously \nafter cleaning a body.",
        "13": "可以对尸体使用清理技能，清理后尸体会消失。\n使用清理后击杀按钮也会同步进入冷却。"
    },
    "UndertakerFullDesc": {
        "0": "Drag corpses across the map; movement speed \nmay be reduced per room configuration.",
        "13": "可以对尸体进行移动，根据房间设置，移动速度可能更慢。"
    },
    "WarlockFullDesc": {
        "0": "Curse a target player, then remotely kill anyone \nstanding near the cursed target.\nYou become immobile for a period \nafter casting this remote kill.\nKills made this way leave the victim dying in place.",
        "13": "术士对目标下咒后，\n可以通过该目标对目标身边的人进行远程击杀，\n使用术士技能击杀后一段时间内无法移动。\n术士击杀，死者表现为原地死亡。"
    },
    "TricksterFullDesc": {
        "0": "Place trick boxes on the map, which activate \nafter one full meeting.\nPlacing three boxes enables a prolonged blackout \nthat cannot be repaired as an emergency sabotage.\nTrick boxes double as usable vents.",
        "13": "可以在地图上放置骗术盒，过一轮会议后生效。\n放满三个盒子后可以熄灯一段时间，\n此关灯状态不属于紧急任务，无法被修复。\n骗术盒可以当做管道使用。"
    },
    "BountyHunterFullDesc": {
        "0": "Eliminate your assigned bounty target \nto drastically shorten your kill cooldown.\nCannot receive cooldown bonuses from the Survivor role.",
        "13": "赏金猎人通过击杀特定目标可以获得较短的击杀CD\n无法被绝境者加成"
    },
    "BlackmailerFullDesc": {
        "0": "Blackmail a player outside meetings \nto silence them entirely during the next discussion phase.",
        "13": "会议外可以勒索一名玩家，使其会议时无法发言。"
    },
    "WitchFullDesc": {
        "0": "Place a curse on a player, marking them \nwith a Witch icon visible in meetings.\nThe cursed player dies once the meeting closes \nunless the Witch is voted out or eliminated.\nIf the setting \"Vote Witch to Save Cursed Target\" is disabled,\nthe cursed player can only be spared \nif the Witch is killed by the Guesser's ability.",
        "13": "拥有诅咒能力，被诅咒的人会议上会显示女巫标记，\n会议结束后死亡（除非女巫被投或者死亡）\n\n如果 \"驱逐女巫可拯救被诅咒者\" 选项为关时，\n只有女巫被赌怪猜测而死才能拯救被诅咒玩家。"
    },
    "NinjaFullDesc": {
        "0": "Mark a target player, then teleport instantly \nbeside them to strike at any time.\nGain temporary invisibility after the kill, \nand green leaf particles spawn at both your original position \nand the victim's location before fading away.",
        "13": "忍者可以标记目标，\n在这之后可以随时瞬移到目标旁边击杀目标。\n击杀后会获得一段时间的隐身，\n并且原地和被击杀的位置都会留下一圈绿色的叶子，\n一段时间后叶子消失。"
    },
    "YoYoFullDesc": {
        "0": "Mark a fixed location, teleport to the marker \non ability activation, and warp back to your starting spot \nonce the ability duration expires.\nComes with a permanent portable full map view.",
        "13": "可以标记一个位置，使用技能后会瞬移到标记点，\n技能有持续时间，持续时间结束后将再瞬移回传送前的位置。\n\n拥有随身管理地图。"
    },
    "JesterFullDesc": {
        "0": "Win the game by getting voted out during a meeting.",
        "13": "在会议中被驱逐即可胜利。"
    },
    "VultureFullDesc": {
        "0": "Permanently sees all corpse locations; win \nby consuming a set number of dead bodies.",
        "13": "秃鹫知晓尸体位置，通过吞噬一定数量尸体后获得胜利。"
    },
    "LawyerFullDesc": {
        "0": "Your goal is to ensure your client survives \nand wins the game.\nYou die alongside your client if they receive \nthe majority vote in a meeting.\nIf your client dies from any other cause, \nyou transform into a Prosecutor.",
        "13": "律师的任务是帮助客户赢得胜利。\n会议上，客户被投时律师也会死亡。\n其他情况下客户死亡，律师会变成起诉人。"
    },
    "PursuerFullDesc": {
        "0": "Survive until the game ends to claim victory.\nLoad other players with blank rounds that nullify \nthe next kill attempt from any kill-capable role.",
        "13": "起诉人的任务是活下去就算赢\n起诉人可以给其他玩家塞空包弹，\n空包弹可以给带刀职业的下一刀击杀无效。"
    },
    "ProsecutorFullDesc": {
        "0": "You receive a designated target at game start.\nSecure victory by voting this target out.\nTransform into a Pursuer if your target dies prematurely.",
        "13": "开局你会有一个目标，\n将这个目标投出去你将获得胜利。\n如果目标死亡你将变为起诉人。"
    },
    "PlagueDoctorFullDesc": {
        "0": "Infect one initial patient zero at the start of the game.\nInfected players contaminate nearby uninfected crewmates \ngradually with a visible infection progress bar.\nWin once every living player is fully infected.\nRoom settings allow the Plague Doctor to keep spreading \nthe plague and win even after being killed.",
        "13": "开局可以使用感染技能感染一个传染源。\n感染源贴近未被传染瘟疫的玩家可以逐渐将其变为感染源(屏幕左边有感染进度)。\n当所有人都被感染瘟疫后,疫医获胜。\n疫医根据房主设置可以在被击杀的情况下继续传染瘟疫最终还是可以获得胜利。"
    },
    "JackalFullDesc": {
        "0": "Possesses kill capability; eliminate all other players \nto win.\nMay recruit another player as a Sidekick based on host settings.\nHas a random chance to spawn with a permanent invisibility ability.",
        "13": "豺狼具有击杀能力，胜利条件为杀死所有其他玩家。\n根据房间设置，豺狼可以选择一名玩家，将其招募为跟班\n豺狼还有概率获得隐身技能。"
    },
    "SidekickFullDesc": {
        "0": "Spawns when the Jackal uses their recruit ability on a player.\nJoin the Jackal's faction and share their win condition \nof eliminating everyone else.\nConfigurable to promote to full Jackal \nupon the original Jackal's death,\npotentially gaining your own recruit ability afterwards.",
        "13": "在豺狼对一名玩家使用招募技能时出现，\n被招募的玩家变成跟班，加入豺狼阵营，\n胜利条件变为杀死所有其他玩家。\n根据房间设置，豺狼死亡时，跟班可能晋升为豺狼，\n甚至可能进一步获得招募新的跟班的权利。"
    },
    "ArsonistFullDesc": {
        "0": "Douse players with gasoline and ignite all doused targets \nsimultaneously from close range.\nIgnition kills all marked players instantly, \nignoring all protection effects.\nHas an extended targeting range compared to most other roles.\nRoom settings may remove ignition cooldown after meetings \nwhen you are the sole remaining killer.",
        "13": "可以给玩家涂油，随时可以在已涂油的目标附近点火。\n点火时会同时击杀所有已涂了油的玩家！（无视各种保护强制击杀）\n另外，纵火狂的技能选中距离会比其他玩家更长。\n\n根据设置，在仅剩纵火狂一名杀手玩家时可以在会议结束后移除点火的冷却。"
    },
    "ThiefFullDesc": {
        "0": "Kill any kill-enabled role (including Sidekicks) \nto steal their unique role ability.\nIn Guesser mode, you may also steal roles \nby correctly guessing kill-capable players.",
        "13": "窃贼可以击杀任何带刀职业，并夺取他们的职业。\n跟班也可被窃取。\n在赌怪模式中，窃贼可以通过猜测带刀的玩家获得身份"
    },
    "CrewmateFullDesc": {
        "0": "Standard Crewmate; complete assigned tasks \nto secure victory for the Crew faction.",
        "13": "普通船员，通过完成任务帮助船员阵营获胜。"
    },
    "NiceGuesserFullDesc": {
        "0": "Determine other players' roles from their meeting statements \nand execute them with a guess ability.\nWarning: You die immediately if your guess is wrong.",
        "13": "会议上可以通过他人发言确定职业后，\n可通过猜测技能将其赌死。\n注意:如果猜测错误你将会死亡。"
    },
    "MayorFullDesc": {
        "0": "Reveal your identity during voting phase \nwith the reveal button, making you immune to guess abilities.\nRevealing grants multiple votes (configurable) \nbut drastically narrows your vision.\nMay unlock emergency meeting remote call per room settings.",
        "13": "市长在投票阶段可以通过点击揭示按钮揭示自己的身份，无法被猜测。\n\n揭示后会议内拥有3票(具体按房间设置为准)，同时视野大幅缩小。\n\n另外，根据房间设置，市长可以拥有远程开会议的能力。"
    },
    "PortalmakerFullDesc": {
        "0": "Place two linked portal devices on the map \nusable by every player.\nYou receive a teleport usage log in chat \nwhenever someone uses your portals once a meeting starts.\nMay use your own portals unrestrictedly per host settings;\nfull teleport history is viewable in meeting chat.",
        "13": "传送师可以在地图上放置两道传送装置，\n传送装置完成后，所有人都可以通过传送装置进行传送。\n其他玩家乘坐传送门时，传送师进入会议后可以收到传送日志。\n\n根据房间设置：传送师可以随时随地使用自己的传送门传送。\n会议中可在聊天框查看传送日志"
    },
    "EngineerFullDesc": {
        "0": "Enter and traverse vents remotely, and instantly fix \nall active sabotages globally.\nHosts may enable a feature that lets Impostors see \nglowing blue vents while you are hiding inside one.",
        "13": "工程师拥有使用通风管道的能力，也能远程一键修复破坏。\n根据房间设置：红/蓝 狼可以得知工程师是否在管道内，即全场管道冒蓝光。"
    },
    "SheriffFullDesc": {
        "0": "The only Crew role with a valid kill ability \nto eliminate Impostors, Jackals and other hostile neutrals.\nKilling an innocent Crewmate results in your own instant death.",
        "13": "警长是船员阵营唯一可以主动刀人的职业。\n他的工作是杀死红狼，干翻豺狼等中立坏蛋。\n但是警长出刀需谨慎，因为试图击杀船员的话，会使自己死亡。"
    },
    "DeputyFullDesc": {
        "0": "The Sheriff's subordinate; gains handcuff ability \nbefore promotion.\nHandcuffing a player locks their abilities, kill button \nand emergency report button temporarily.\nAutomatically promotes to full Sheriff \nif the original Sheriff dies.",
        "13": "捕快是警长的下属，在未成为警长前拥有手铐技能。\n捕快可以对目标上拷，使被拷人的技能、击杀、\n报警按钮在被点击的时候封锁几秒。\n警长死亡后，捕快可以晋升为警长"
    },
    "DetectiveFullDesc": {
        "0": "Visualize footprints marked with their owner's player color.\nReporting a corpse pulls an autopsy report into chat.\nReport instantly after death to view the killer's exact role;\nreport shortly after death to learn the killer's faction.",
        "13": "侦探可以看到脚印和对应的颜色。\n此外，侦探报警可以在聊天框获得尸检报告，\n在尸体死亡极短时间内报警可以知道凶手职业，\n在尸体死亡的一段时间内报警可得知凶手具体阵营。"
    },
    "TimeMasterFullDesc": {
        "0": "Activate Time Shield to block one fatal kill \nand rewind time several seconds backwards.\nTime rewind cannot revive already deceased players.",
        "13": "时间之主拥有时光之盾，\n开启后受到击杀将免疫死亡并使时光回溯几秒钟。\n时间回溯并不能复活已死之人。"
    },
    "VeteranFullDesc": {
        "0": "Enter guard mode with your ability.\nAny player interacting with you (kill, recruit, track, shield, \ndouse, handcuff, etc.) gets killed instantly by reflected damage.",
        "13": "老兵可以选择使用技能进入警戒状态，\n当他们处于警戒状态时，所有与之交互\n（包括击杀、招募、追踪、套盾、纵火、上拷等交互技能）\n玩家都将被反弹死。"
    },
    "MedicFullDesc": {
        "0": "Place a permanent protection shield on a target \nthat blocks all kill attempts.\nReporting a corpse generates an autopsy log.\nReport immediately post-mortem to view the killer's username;\nreport shortly after death to check the killer's color shade.",
        "13": "医生可以给目标套盾，被套盾的人无法被击杀。\n此外，医生报警可以获得尸检报告，\n在尸体死亡极短时间内报警可以知道凶手名称，\n在尸体死亡的一段时间内报警可得知凶手颜色深浅。"
    },
    "SwapperFullDesc": {
        "0": "Swap the vote counts of two different players \nduring meetings.\nComplete tasks to earn additional swap uses.",
        "13": "换票师可以在会议期间交换两名玩家身上的票数。\n更多的换票次数可以通过做任务获得。"
    },
    "SeerFullDesc": {
        "0": "Receive a screen flash notification whenever any player dies.\nMay view spirit orbs at death locations based on room configuration.",
        "13": "灵媒可以感知死亡，有玩家死亡时，屏幕会闪光。\n此外，根据房间设置，灵媒可以看见死亡位置的魂"
    },
    "HackerFullDesc": {
        "0": "Remotely access the vitals panel and admin map.\nHack the admin map to display player colors \nand vitals to show precise death timestamps.\nYou cannot move while hacking systems.",
        "13": "黑客可以远程使用生命检测议和管理室地图，\n使用黑入技能后，管理室地图可显示颜色，\n生命检测仪能显示具体死亡时间。\n技能使用期间，黑客无法移动。"
    },
    "TrackerFullDesc": {
        "0": "Activate ability to spawn a directional arrow \npointing toward all corpses for a set duration.\nAttach a tracking beacon to a player \nfor a permanent directional marker pointing to them.",
        "13": "追踪者开启技能后一段时间，会有箭头指向尸体，\n时间结束后，箭头消失。\n此外，追踪者还可以对一名玩家插入追踪器，\n屏幕上将始终有一个箭头指向被跟踪人。"
    },
    "LighterFullDesc": {
        "0": "Possesses an expanded vision radius; rotate your view \nby moving your mouse.",
        "13": "执灯人有比较大的视野，\n通过鼠标的移动以观察其他方向。"
    },
    "SnitchFullDesc": {
        "0": "After finishing all tasks, view directional indicators \npointing to every evil faction member.\nWhen only one task remains, marked evil players receive \na permanent arrow pointing directly at you.\nCannot be killed by Guesser abilities.\nToggle full evil role details visibility in meetings via host settings.",
        "13": "告密者做完所有任务后，可以知晓场上所有邪恶阵营的方向。\n当告密者仅剩最后一个任务时将向被揭示的玩家发出警告，\n被揭示玩家将有箭头持续指向告密者。\n注：告密者被发现时无法被猜测死亡。\n可选是否在会议中查看邪恶阵营玩家与详细职业。"
    },
    "SpyFullDesc": {
        "0": "Impostors see your name colored red \nidentical to their teammates.\nYour existence allows Impostors \nto accidentally kill their own allies.",
        "13": "在红狼视野中，卧底名字和红狼队友一样显示为红色。\n当一局游戏存在卧底时，红狼可以击杀队友。"
    },
    "SecurityGuardFullDesc": {
        "0": "Seal vents and place surveillance cameras \nthat activate after the next meeting ends.\nAll players can view placed blockades and cameras.\nComplete tasks to unlock extra ability charges.",
        "13": "保安可以封锁通风管道，和放置监控。\n在下轮会议结束后生效，\n且所有人都能看见封锁装置和监控装置。\n做任务能够提升保安使用技能的次数。"
    },
    "MediumFullDesc": {
        "0": "Commune with deceased players' spirits \nat their death spot after a meeting ends.\nReceive investigation clues about the victim \nin meeting chat, with a chance for bonus intelligence.",
        "13": "会议结束后，可以在上轮死亡玩家的死亡地点，对灵魂通灵。\n进入会议后从对话框中得到死者相关信息。\n有一定概率会获得额外信息。"
    },
    "TrapperFullDesc": {
        "0": "Place hidden traps on the map.\nTwo separate players stepping on the same trap \nreveals their role, faction and name in meeting chat.\nAn arrow points toward your triggered trap once someone steps on it.",
        "13": "猎人可以在地图上放置陷阱，\n当有两名玩家都踩中陷阱时，\n进入会议后对话框将显示他们的 ( 职业/阵营/名称 ) 。\n当有人踩中夹子时，陷阱师会有箭头指向被踩的夹子。"
    },
    "DisperserFullDesc": {
        "0": "Assigned Faction: Impostor\nScramble the positions of every living player \nacross the entire map.",
        "13": "分配阵营：伪装者\n\n分散者可以打乱当前所有玩家位置。"
    },
    "BloodyFullDesc": {
        "0": "Assigned Faction: All Players\nYour killer leaves a permanent blood splatter \non the ground after eliminating you.",
        "13": "分配阵营：全部玩家\n\n被击杀后，凶手会在地上留下血迹"
    },
    "AntiTeleportFullDesc": {
        "0": "Assigned Faction: All Players\nSnap back to your exact pre-meeting/pre-scramble position \nafter meetings or map dispersion.",
        "13": "分配阵营：全部玩家\n\n会议及分散后，厄运儿会回到会议前和分散前的位置。"
    },
    "TiebreakerFullDesc": {
        "0": "Assigned Faction: All Players\nYour single vote counts as 1.5 votes \nduring voting phases to break ties.",
        "13": "分配阵营：全部玩家\n\n破平者的投票时，票数计为1.5票"
    },
    "BaitFullDesc": {
        "0": "Assigned Faction: All Players (configurable to Crew Only)\nYour killer automatically triggers an emergency body report \nupon eliminating you.",
        "13": "分配阵营：全部玩家（可设置为仅船员）\n\n被击杀后凶手自动报警"
    },
    "SunglassesFullDesc": {
        "0": "Assigned Faction: Crew\nYour vision radius is permanently reduced.",
        "13": "分配阵营：船员\n\n视野会变小"
    },
    "MiniFullDesc": {
        "0": "Assigned Faction: All Players\nInvulnerable to kills until coming of age, \nbut your kill cooldown is doubled.\nBecome killable with shortened cooldown once mature.\nIf voted out while on the Crew faction, \nevery player loses the game instantly.",
        "13": "分配阵营：全部玩家\n\n18岁之前不可被击杀，但击杀CD双倍。\n18岁后可被击杀且击杀CD变短。\n\n此外，小孩被驱逐时，如果小孩为船员则结束游戏（所有玩家失败）"
    },
    "VIPFullDesc": {
        "0": "Assigned Faction: All Players\nEvery player gets a screen flash notification \nwhen you die.\nColor-coded flashes can be enabled: White=Crew, \nBlue=Neutral, Red=Impostor.",
        "13": "分配阵营：全部玩家\n\nVIP死亡时，所有人都会接收到闪光。\n如果房间设置闪光可显示阵营颜色，\n则白色闪光代表死者为船员，蓝色代表中立，红色代表红狼。"
    },
    "InvertFullDesc": {
        "0": "Assigned Faction: All Players\nYour movement controls are flipped; controls revert \nto normal after several meetings pass.",
        "13": "分配阵营：全部玩家\n\n移动方向相反，过几次会议后即可醒酒"
    },
    "BlindFullDesc": {
        "0": "Assigned Faction: All Players\nYou cannot manually report any dead bodies.",
        "13": "分配阵营：全部玩家\n\n胆小鬼无法报告尸体。"
    },
    "ChameleonFullDesc": {
        "0": "Assigned Faction: All Players\nGradually turn translucent and invisible while standing still; \nmovement cancels camouflage immediately.",
        "13": "分配阵营：全部玩家\n\n站在原地不动可以逐渐变色隐身，移动后会解除隐身状态。"
    },
    "ShifterFullDesc": {
        "0": "Assigned Faction: Crew (configurable to Neutral Shifter)\nSwap your primary role with another living player \nduring action phase; a yellow text hint appears under both names.\nRole swap activates after the next meeting.\nSuicide automatically if you swap with a non-Crew member (toggleable).\nYour swap ability is consumed permanently after exchange completes.\nPrimary use case: inherit powerful Crew roles such as Sheriff \nbefore their death.\nSwapping still takes effect even if either player dies afterwards.",
        "13": "分配阵营：船员（可设置为中立交换师）\n\n可以在行动阶段与其他玩家交换主职业，交换时名字下方会有黄字提示，\n会议结束后生效。\n如果交换目标不是船员（可以设置），会议结束时会自杀。\n（交换完毕后此附加能力消失）\n提示：交换师的目的主要是为了继承船员强力职业，\n例如在警长死亡前将身份交换。\n\n注：玩家死亡不会影响交换效果。"
    },
    "LoverFullDesc": {
        "0": "Assigned Faction: All Players\nTwo linked lovers share a bonded fate: one dies, \nthe other commits suicide together.\nHas a dedicated private chat channel exclusive to the pair.\nWin conditions depend on the individual base roles \nassigned to each lover.\nBond types: Good Bond (Crew+Crew), Evil Bond \n(Neutral+Crew / Neutral+Impostor / Crew+Impostor).",
        "13": "分配阵营：全部玩家\n\n种类：好链子:船员+船员，坏链子:中立+船员/中立+内鬼/船员+内鬼。\n恋人是一对同生共死的命运共同体，\n当一方死掉了另一方会一起殉情。\n恋人有一个独立的聊天系统。\n根据双方分配的职业以帮助恋人阵营获胜。"
    },
    "ArmoredFullDesc": {
        "0": "Assigned Faction: Crew\nSpawn with a single-use shield that blocks exactly \none incoming fatal kill attempt.",
        "13": "分配阵营：船员\n开局后你有一个一次性护盾，\n可以帮你阻挡一次击杀。"
    },
